{
  "name": "fincode-shell",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Fincode: CRM с канбаном сделок и справочником клиентов, раздел Service Desk",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "preview": "node server/index.mjs",
    "migrate": "node server/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "screenshots": "npm run build && node tools/screenshots.mjs",
    "check:dev": "node tools/live-check.mjs",
    "check:money": "node tools/check-money.mjs",
    "check:api": "node tools/check-api.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
